{
  "name": "assetorbit",
  "version": "1.0.0",
  "private": true,
  "description": "AssetOrbit enterprise asset management system",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "backend": "npm run dev --workspace backend",
    "frontend": "npm run dev --workspace frontend",
    "db:init": "npm run db:init --workspace backend",
    "check": "npm run check --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
